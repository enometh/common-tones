(in-package "CL-USER")

(mk:defsystem :piston-simple-pulse
  :source-pathname *common-tones-source-dir*
  :binary-pathname *common-tones-binary-dir*
  :source-extension "lisp"
  :depends-on ("cffi" "bordeaux-threads")
  :components
  ((:module "scratch/"
    :components ((:file "piston-simple-pulse")))))

#+nil
(mk:oos :piston-simple-pulse :load)
